; SPDX-License-Identifier: CC-BY-ND-4.0
; -----------------------------------------------------------------------------
; Formal RFC 5234 / RFC 7405 ABNF Grammar for the MADE Specification (v1.0.0-rc1)
; Measure of AI in Design & Execution (MADE)
; -----------------------------------------------------------------------------

made-construct      = made-disclosure / file-header-tag / component-tag / nfo-summary-line

made-disclosure     = canonical-prefix SP shorthand-rating [ SP expanded-clause ] [ SP tool-attribution ]

canonical-prefix    = %s"MADE:"

shorthand-rating    = ideation-expr SP "/" SP execution-expr

; Note: Multi-level expressions must list levels in ascending numerical order (0 to 4).
; Consecutive levels with no gaps must be joined with a hyphen (e.g., "I0-I1"), never a comma ("I0,I1").
; Presentation Note: When extracting ratings from HTML or Markdown where non-breaking
; spaces (%xA0 or "&nbsp;") are used to prevent wrapping, normalize them to SP (%x20).
ideation-expr       = ideation-token *( "," ideation-token )
ideation-token      = %s"I" level-digit [ %s"-I" level-digit ]

execution-expr      = execution-token *( "," execution-token )
execution-token     = %s"E" level-digit [ %s"-E" level-digit ]

level-digit         = "0" / "1" / "2" / "3" / "4"

expanded-clause     = "(" classification-desc ")"
classification-desc = %s"Ideation:" SP title-list ";" SP %s"Execution:" SP title-list
single-class-desc   = %s"Ideation:" SP title ";" SP %s"Execution:" SP title

title-list          = title *( "," SP title )
title               = %s"Unassisted" / %s"Assisted" / %s"Collaborative" / %s"Directed" / %s"Autonomous"

; -----------------------------------------------------------------------------
; Component & File-Level Classification Grammar (Sections 4.3 & 4.4)
; -----------------------------------------------------------------------------

file-header-tag     = single-line-comment canonical-prefix SP single-file-score [ SP "(" single-class-desc ")" ] [ SP tool-attribution ]
                    / c-block-open canonical-prefix SP single-file-score [ SP "(" single-class-desc ")" ] [ SP tool-attribution ] SP "*/"
                    / html-open canonical-prefix SP single-file-score [ SP "(" single-class-desc ")" ] [ SP tool-attribution ] SP "-->"

single-file-score   = %s"I" level-digit SP "/" SP %s"E" level-digit

component-tag       = "(" ( single-file-score / "`" single-file-score "`" ) "," SP single-class-desc ")"
                    / "[" single-file-score SP "(" single-class-desc ")" "]"

nfo-summary-line    = nfo-ideation-line / nfo-execution-line
nfo-ideation-line   = *SP %s"Ideation" 1*SP ":" SP ideation-expr SP "(" title-list ")"
nfo-execution-line  = *SP %s"Execution" 1*SP ":" SP execution-expr SP "(" title-list ")"

single-line-comment = "//" SP / "#" SP / ";" SP / "--" SP
c-block-open        = "/*" SP
html-open           = "<!--" SP

; -----------------------------------------------------------------------------
; Optional Tool & Model Attribution Extension (Section 4.5)
; -----------------------------------------------------------------------------

tool-attribution    = "[" tool-name *( "," SP tool-name ) "]"
tool-name           = tool-word *( SP tool-word )
tool-word           = 1*( ALPHA / DIGIT / "-" / "." / "_" / "/" / "+" )
