; -----------------------------------------------------------------------------
; Formal RFC 5234 ABNF Grammar for the MADE Specification (v0.1 Standard)
; Measure of AI in Design & Execution (MADE)
; -----------------------------------------------------------------------------

made-disclosure     = canonical-prefix SP ( disclosure-body / expanded-standalone ) [ SP tool-attribution ]

canonical-prefix    = "MADE:"

disclosure-body     = shorthand-rating [ SP expanded-clause ]

shorthand-rating    = ideation-expr SP "/" SP execution-expr

; Note: Multi-level expressions must list levels in ascending numerical order (0 to 4).
; Consecutive levels with no gaps must be joined with a hyphen (e.g., "I0-I1"), never a comma ("I0,I1").
; Presentation Note: When extracting ratings from HTML or Markdown where non-breaking
; spaces (%xA0 or "&nbsp;") are used to prevent wrapping, normalize them to SP (%x20).
ideation-expr       = ideation-token *( "," ideation-token )
ideation-token      = "I" level-digit [ "-I" level-digit ]

execution-expr      = execution-token *( "," execution-token )
execution-token     = "E" level-digit [ "-E" level-digit ]

level-digit         = "0" / "1" / "2" / "3" / "4"

expanded-standalone = expanded-ideation ";" SP expanded-execution
expanded-clause     = "(" ( ( expanded-ideation ";" SP expanded-execution ) / classification-desc ) ")"

expanded-ideation   = "Ideation" SP level-expr SP "(" title-list ")"
expanded-execution  = "Execution" SP level-expr SP "(" title-list ")"

level-expr          = level-range *( "," level-range )
level-range         = level-digit [ "-" level-digit ]
title-list          = title *( ", " title )
title               = "Unassisted" / "Assisted" / "Collaborative" / "Directed" / "Autonomous"

; -----------------------------------------------------------------------------
; Component & File-Level Classification Grammar (Sections 4.3 & 4.4)
; -----------------------------------------------------------------------------

file-header-tag     = comment-prefix canonical-prefix SP single-file-score [ SP "(" classification-desc ")" ] [ SP tool-attribution ] [ comment-suffix ]

single-file-score   = "I" level-digit SP "/" SP "E" level-digit
classification-desc = "Ideation:" SP title ";" SP "Execution:" SP title

component-tag       = "(" single-file-score "," SP classification-desc ")" / "[" single-file-score SP "(" classification-desc ")" "]"

nfo-ideation-line   = "Ideation" 1*SP ":" SP ideation-expr SP "(" title-list ")"
nfo-execution-line  = "Execution" 1*SP ":" SP execution-expr SP "(" title-list ")"

comment-prefix      = "//" SP / "#" SP / ";" SP / "--" SP / "/*" SP / "<!--" SP
comment-suffix      = SP "*/" / SP "-->"

; -----------------------------------------------------------------------------
; Optional Tool & Model Attribution Extension (Section 4.5)
; -----------------------------------------------------------------------------

tool-attribution    = "[" tool-name *( "," SP tool-name ) "]"
tool-name           = tool-word *( SP tool-word )
tool-word           = 1*( ALPHA / DIGIT / "-" / "." / "_" / "/" / "+" )
